[Unit]
Description=IjaraGo PocketBase
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/ijarago/pb
ExecStart=/root/projects/ijarago/pb/pocketbase serve --http=127.0.0.1:8091
Restart=always
RestartSec=5

# PocketBase faqat localhost'da tinglaydi — tashqariga nginx chiqaradi
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
